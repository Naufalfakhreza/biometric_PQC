# ==============================================================================
# Post-Quantum Biometric Authentication Configuration
# ==============================================================================

# Server Network Settings
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_URL=http://127.0.0.1:8000

# Security & API Keys
# Optional API key for authenticating requests between client and server.
# Leave empty to disable API key enforcement.
API_KEY=your_secure_api_key_here

# Local Secure Enclave & Keyring Settings
KEYRING_SERVICE=PQC_FaceAuth_Enclave
ENCLAVE_DIR=local_enclave

# Biometric & Camera Settings
CAMERA_INDEX=0
DETECTOR_BACKEND=retinaface
ARCFACE_COSINE_THRESHOLD=0.68
ENABLE_ANTI_SPOOFING=false

# Cryptographic Protocol Timers (in seconds)
CHALLENGE_TTL_SECONDS=60
TOKEN_TTL_SECONDS=3600

# Enclave Key Chunking Settings (Windows Credential Manager payload limits)
CHUNK_SIZE=800
NUM_CHUNKS=4
